# Copy this file to ".env" (same folder) and fill in the values.
# ".env" is listed in .gitignore, so it never reaches GitHub.
# In GitHub Actions the same names are provided as encrypted repository secrets.

# --- Market data (https://finnhub.io -> Dashboard -> API key) ---
FINNHUB_API_KEY=

# --- Which companies to track (comma separated) ---
TICKERS=AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA

# --- Snowflake (key-pair auth for the ingestion service user) ---
# Account identifier, e.g. myorg-ab12345  (hyphens, no ".snowflakecomputing.com")
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=TKO_INGEST_SVC
SNOWFLAKE_ROLE=TKO_INGESTER
SNOWFLAKE_WAREHOUSE=TKO_WH
SNOWFLAKE_DATABASE=TKO_DB
# Path to the private key created by scripts/generate_keypair.py (local runs)
SNOWFLAKE_PRIVATE_KEY_PATH=keys/tko_ingest_rsa_key.p8
# In GitHub Actions the key CONTENT is passed instead, as SNOWFLAKE_PRIVATE_KEY
